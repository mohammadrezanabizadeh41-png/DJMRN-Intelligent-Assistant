{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:djmrn:m1:manifest:v1",
  "title": "PRIVATE OPERATOR-SIDE MANIFEST - NOT EXPOSED TO MODEL",
  "description": "Source schema only; no file identity has been attested on user Windows and active grants MUST NOT be persisted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "revision",
    "owner_sid",
    "active",
    "files"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "owner_sid": {
      "type": "string",
      "pattern": "^S-1-"
    },
    "active": {
      "const": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file_id",
          "display_name",
          "absolute_path",
          "sha256",
          "expected_bytes",
          "volume_serial",
          "file_index",
          "link_count"
        ],
        "properties": {
          "file_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "absolute_path": {
            "type": "string",
            "description": "local trusted operator only; never part of model/tool response"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expected_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "volume_serial": {
            "type": "integer",
            "minimum": 0
          },
          "file_index": {
            "type": "integer",
            "minimum": 0
          },
          "link_count": {
            "const": 1
          }
        }
      }
    }
  }
}
