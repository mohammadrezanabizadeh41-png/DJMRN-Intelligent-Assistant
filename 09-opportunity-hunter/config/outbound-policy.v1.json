{
  "schema_version": "djmrn.oh.outbound-policy.v1",
  "default_mode": "DRAFT_ONLY",
  "sites": {
    "freelancermap": {
      "plan": "Basic",
      "monthly_application_limit": 10,
      "quota_source": "https://www.freelancermap.com/pricing/freelancer",
      "quota_reset_rule": "UNVERIFIED_USER_ESTIMATE",
      "account_remaining_quota": 10,
      "automation_permission": "UNVERIFIED",
      "max_daily_applications": 1,
      "send_enabled": false,
      "require_per_project_approval": true,
      "stop_on": [
        "CAPTCHA",
        "HTTP_429",
        "ACCOUNT_WARNING",
        "UNKNOWN_SEND",
        "QUOTA_UNKNOWN",
        "AUTOMATION_PERMISSION_UNVERIFIED"
      ],
      "plan_verified_by_user": true,
      "plan_verified_date": "2026-10-28",
      "quota_remaining_source": "USER_REPORTED",
      "quota_observed_date": "2026-10-28",
      "membership_elapsed_days_reported": 10,
      "next_reset_days_reported": 20,
      "next_reset_estimate": "2026-11-17"
    }
  },
  "global": {
    "minimum_spacing_seconds": 300,
    "scope": "all_sites_all_accounts",
    "basis": "last_successful_or_uncertain_send",
    "note": "minimum spacing, not authorization to automate"
  }
}
